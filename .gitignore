# --- Project data and outputs ----------------------------------------------
# Input images ARE tracked, by explicit instruction (2026-09-24 overnight
# brief, reaffirmed 2026-09-28): the repo is meant to be self-contained, so
# a run is reproducible from the repo alone. The 8 WT .tif files are 2-3 MB
# each, 24 MB total. The blinding key stays excluded regardless -- see the
# code_key section below, which is what actually must never be committed.
# Generated masks, overlays, CSVs, figures - reproducible from data/ + code.
# Exception: results/count/ (v2 outputs) is deliberately committed for now,
# while v2 is under active review -- see git log.
results/*
# Committed output subtrees. `results/*` above ignores everything, so EVERY
# new top-level folder under results/ needs an exception added here or its
# contents are silently left out of commits -- which is exactly what
# happened to results/lacunae/ and results/candidates/ when the 2026-09-28
# reorganization renamed results/count/ and results/count_v3_candidate/.
# If you add a folder under results/, add it here too.
!results/canaliculi/
!results/canaliculi/**
!results/lacunae/
!results/lacunae/**
!results/candidates/
!results/candidates/**
# Phase 0 diagnostics: the evidence the later phases are argued from,
# so it is kept with the code that produced it.
!results/diagnostics/
!results/diagnostics/**

# --- Blinding key ----------------------------------------------------------
# Maps coded specimen IDs to experimental groups. Committing this would
# unblind the analysis for anyone with repo access.
code_key
code_key.*
*code_key*

# --- Python environments ---------------------------------------------------
venv/
.venv/
env/
ENV/
*.egg-info/
.Python

# --- Python bytecode / caches ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# --- Editors and OS junk ---------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Local, machine-specific overrides -------------------------------------
# Personal paths / secrets that shadow config.py on a single machine.
config_local.py
.env
# Claude Code project/tooling config stays local, out of version control.
.claude/

# --- Stray installers / downloads (never belong in the repo) ---------------
*-installer.exe
