# Local environment and cache files are excluded, and so are the diagnostic and
# archive folders listed at the end, which commands rerun into results/ but which
# are not results. Code, data, both result sets and the reports are tracked.
venv/
__pycache__/
.cache/
.ipynb_checkpoints/
.DS_Store

# Blinding keys (added 2026-10-02, publication-fixes B1): a key links coded
# image names to the originals and must never be committed. The blind
# subcommand refuses to write one inside the repository; these patterns are a
# second guard.
code_key*
*_key.csv
# Claude Code settings for this machine, not part of the pipeline.
.claude/

# The AI judge experiment (branch exp-ai-layer, docs/EXPERIMENT_AI.md). The API
# key is read from the environment and is never written to a file; a .env is
# ignored here as a second guard, as the blinding keys are above.
.env
.env.*

# Removed from the repository on 2026-10-20 (cleanup). Each is written again when
# its command reruns, so it is ignored rather than tracked a second time. The
# command that makes each one is cited where the docs use it, and the files as
# they were are at commit bf3b982. Since 2026-10-20 the per-image and all_images
# folders sit one level down, in results/<group>/.
results/*/*/4_archive_not_used/
results/*/all_images/archive_not_used/
results/diagnosis_543_3/
results/ai_dry_run/
results/ridge_background/
results/empty_zone/
results/contact_census/
results/network_shape/
results/survey/
results/glow_zone/
results/hole_zone/
