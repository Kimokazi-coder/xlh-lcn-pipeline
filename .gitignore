# --- Project data and outputs ----------------------------------------------
# POLICY (reaffirmed 2026-09-29): push everything. Input images, results/,
# reports/ and docs/ are all tracked and pushed, by explicit instruction --
# the repo is meant to be fully self-contained, so a run is reproducible
# from the repo alone. There is no blanket ignore on data/ or results/ any
# more (an earlier `results/*` + per-folder allowlist here was a foot-gun:
# a new results/ subfolder was silently dropped from commits unless someone
# remembered to add an exception for it -- that already happened once,
# during the 2026-09-28 reorganization). The blinding key is the one
# absolute, unconditional exclusion -- see code_key below.

# --- Blinding key ----------------------------------------------------------
# Maps coded specimen IDs to experimental groups. Committing this would
# unblind the analysis for anyone with repo access.
code_key
code_key.*
*code_key*

# --- Python environments ---------------------------------------------------
venv/
.venv/
env/
ENV/
*.egg-info/
.Python

# --- Python bytecode / caches ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# --- Editors and OS junk ---------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Local, machine-specific overrides -------------------------------------
# Personal paths / secrets that shadow config.py on a single machine.
config_local.py
.env
# Claude Code project/tooling config stays local, out of version control.
.claude/

# --- Stray installers / downloads (never belong in the repo) ---------------
*-installer.exe
